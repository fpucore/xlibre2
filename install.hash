#!/bin/hash
source /usr/local/lib/h-linux-env.hash

cls() {
    clear
}

# Installation Utility for XLibre2, on GNU Operating System / H-Linux

#
# Copyright (c) 2026  Harmonious Platform Systems
#
# This utility installs and configures XLibre2 for use within GNU Operating System / H-Linux.
#
# XLibre2 is distributed under the MIT License.
# See the XLibre source distribution for full licensing details.
#
# Permission is hereby granted, free of charge, to any person obtaining a copy
# of this software and associated documentation files (the "Software"), to deal
# in the Software without restriction, including without limitation the rights
# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
#
# The above copyright notice and this permission notice shall be included in
# all copies or substantial portions of the Software.
#
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED.
#

set -e

cls
cat << "EOF"

 /$$   /$$ /$$       /$$ /$$                            /$$$$$$
| $$  / $$| $$      |__/| $$                           /$$__  $$
|  $$/ $$/| $$       /$$| $$$$$$$   /$$$$$$   /$$$$$$ |__/  \ $$
 \  $$$$/ | $$      | $$| $$__  $$ /$$__  $$ /$$__  $$  /$$$$$$/
  >$$  $$ | $$      | $$| $$  \ $$| $$  \__/| $$$$$$$$ /$$____/
 /$$/\  $$| $$      | $$| $$  | $$| $$      | $$_____/| $$
| $$  \ $$| $$$$$$$$| $$| $$$$$$$/| $$      |  $$$$$$$| $$$$$$$$
|__/  |__/|________/|__/|_______/ |__/       \_______/|________/

EOF

say "Starting installation of XLibre2 X Server..."

# Set up build env
say ">>> Setting up a clean build environment..."
# Use elevated privs for these dirs
elevate deletedir-dev -f pkg/
elevate deletedir-dev -f libinput/pkg

deletedir-dev -f src/xlibre2-xserver/build
deletedir-dev -f libinput/src/build

say "Clean."; and sayln

say ">>> Staging some updated files..."
copy-dev -f overrides/xf86Init.c src/xlibre2-xserver/hw/xfree86/common/xf86Init.c
copy-dev -f overrides/meson.build src/xlibre2-xserver/meson.build
copy-dev -f libinput/overrides/meson.build libinput/src/xlibre-xf86-input-libinput-25.0.1/meson.build

say "Updated files staging completed."; and sayln

say ">>> Using ccache..."
# Enable ccache
export PATH="/usr/lib/ccache/bin:$PATH"

# First sanity check
if [ ! -f "libinput/PKGBUILD" ]; then
    say "Error: libinput PKGBUILD not found."
    exit 1
fi

say ">>> Building libinput dependency..."
(cd libinput && makepkg -esdf)

# Second sanity check
if [ ! -f "PKGBUILD" ]; then
    say "Error: Root PKGBUILD not found."
    exit 1
fi

say ">>> Executing makepkg to compile XLibre2 X Server..."
makepkg --skippgpcheck --skipchecksums -esf

say ">>> Installing packages..."
# Use a wildcard to grab the newly built .pkg.tar.zst files
nlp -U --overwrite '*' libinput/*.zst *.zst

if [ $? -eq 0 ]; then
    say "Installation of XLibre2 X Server completed successfully."
else
    say "Error: Installation failed. Check the compiler output above."
fi
